# Copia este archivo como ".env" y ajusta los valores a tu entorno local.
# NUNCA subas el archivo ".env" real a GitHub (ya esta en .gitignore).

PORT=4000

# Datos de conexion a PostgreSQL (ajusta a tu instalacion local)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sistema_apoyo_aprendizaje
DB_USER=postgres
DB_PASSWORD=tu_password

# Llave secreta para firmar tokens JWT (invéntala, que sea larga y aleatoria)
JWT_SECRET=cambia_esto_por_una_llave_larga_y_aleatoria
